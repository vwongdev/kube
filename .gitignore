# Terraform state files
*.tfstate
*.tfstate.*

# Crash log files
crash.log

# Exclude override files as they are usually local
*.tfvars
*.tfvars.json
!providers/aws/env/*.tfvars

# Ignore Terraform plan output
*.plan

# Ignore .terraform directory
.terraform/

# direnv cache
.direnv/

# Local k3d secret store holding real credentials
providers/k3d/secret-store.yaml
